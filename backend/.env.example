# 数据库（开发默认 SQLite，生产用 PostgreSQL）
DATABASE_URL=sqlite:///./quantbot.db
# DATABASE_URL=postgresql://quant:quant@localhost:5432/quantbot

# Redis（Celery 定时任务）
REDIS_URL=redis://localhost:6379/0

# 安全密钥（生产环境必须修改）
SECRET_KEY=change-me-in-production

# 调试模式
DEBUG=true

# 数据源: "akshare"(默认) | "baostock" | "eastmoney" | "yfinance" | "mock"
DATA_SOURCE=akshare

# CORS 允许的域名（逗号分隔，空则允许所有）
CORS_ORIGINS=
