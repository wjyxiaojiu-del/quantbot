# QuantBot 环境变量配置
# 复制为 .env 并按需修改

# ── 数据库 ──
# 开发环境默认 SQLite，生产环境用 PostgreSQL
DATABASE_URL=sqlite:///./quantbot.db
# DATABASE_URL=postgresql://quant:quant@localhost:5432/quantbot

# ── Redis（Celery 消息队列）──
REDIS_URL=redis://localhost:6379/0

# ── 安全 ──
# 生产环境必须修改！不能使用默认值
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── 调试 ──
DEBUG=true

# ── 数据源 ──
# 可选: akshare | baostock | eastmoney | yfinance | mock
DATA_SOURCE=akshare
AKSHARE_TIMEOUT=30
DATA_BATCH_SIZE=1000

# ── CORS ──
# 逗号分隔的允许域名列表，空则允许所有
# CORS_ORIGINS=https://your-domain.com,https://another.com
